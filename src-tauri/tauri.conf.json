{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dynamic-island",
  "version": "0.1.0",
  "identifier": "com.dynamicisland.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dynamic Island",
        "label": "main",
        "width": 800,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Floating Linux Dynamic Island desktop widget",
    "longDescription": "A lightweight, floating desktop widget for Linux inspired by Apple's Dynamic Island, engineered with Tauri 2, Svelte 5, and Rust for Ubuntu Cinnamon on X11.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "python3"
        ],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/bin/island-cli": "../scripts/island-cli.py"
        }
      }
    }
  }
}
